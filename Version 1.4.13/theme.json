        { "slug": "hero-brown-primary", "name": "قهوه‌ای اصلی", "color": "#4A3022" },
        { "slug": "hero-brown-light", "name": "قهوه‌ای روشن", "color": "#684936" },
        { "slug": "dark-espresso", "name": "اسپرسو تیره", "color": "#2C1D16" },
        { "slug": "cream-primary", "name": "کرم اصلی", "color": "#F2E9DA" },
