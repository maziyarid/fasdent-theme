{
  "$schema": "https://design-tokens.org/schema.json",
  "name": "Alipasandi Clinic — Final Approved System",
  "version": "1.4.7",
  "color": {
    "hero-brown-primary": { "$type": "color", "$value": "#4A3022" },
    "hero-brown-light": { "$type": "color", "$value": "#684936" },
    "dark-espresso": { "$type": "color", "$value": "#2C1D16" },
    "cream-primary": { "$type": "color", "$value": "#F2E9DA" },
    "cream-light": { "$type": "color", "$value": "#F8F2E8" },
    "caramel-accent": { "$type": "color", "$value": "#C58D52" }
  },
  "typography": {
    "body": "Vazirmatn",
    "logo": "Playfair Display"
  },
  "layout": {
    "container": "1320px",
    "radius": "12px",
    "button-radius": "8px",
    "breakpoints": {
      "mobile-sm": "559px",
      "mobile": "767px",
      "tablet": "768px",
      "desktop": "1200px"
    }
  },
  "rollout": {
    "approved-scope": "site-wide",
    "internal-pages": "extended",
    "status": "final-qa"
  },
  "source-of-truth": [
    "assets/design-tokens.json",
    "assets/css/theme.css :root"
  ]
}
